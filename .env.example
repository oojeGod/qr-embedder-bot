# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# QR Code Settings
# Error correction level: l, m, q, h (h = highest)
QR_CODE_ERROR_CORRECTION=h

# QR code module size in pixels
QR_CODE_SIZE=10

# Opacity of QR code overlay (0.01-0.1, lower = more invisible)
QR_CODE_OPACITY=0.05

# Image Processing
# Maximum image size in MB
MAX_IMAGE_SIZE_MB=10

# Temporary folder for processing
TEMP_FOLDER=./tmp